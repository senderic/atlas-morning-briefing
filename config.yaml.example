arxiv_topics:
  - "Agentic AI"
  - "Agent Evaluation"
  - "Multi-Agent Systems"
  - "Tool Use LLM"
  - "VLA Robotics"
  - "World Models"
  - "NKI Trainium"
  - "Physical AI Embodied"
  - "Autonomous Driving End-to-End"
  - "Reinforcement Learning Code Generation"
  - "LLM Inference Optimization"
  - "AI Safety Alignment"


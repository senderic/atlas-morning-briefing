# Interest profile for relevance filtering
interest_profile:
  - topic: "Agentic AI"
    weight: 1.0
  - topic: "Trainium NKI Neuron SDK"
    weight: 0.9
  - topic: "VLA Robotics Physical AI"
    weight: 0.8
  - topic: "Multi-Agent Systems"
    weight: 0.8
  - topic: "Enterprise AI adoption"
    weight: 0.7
  - topic: "LLM inference optimization"
    weight: 0.7
  - topic: "Autonomous driving"
    weight: 0.6
  - topic: "AI safety alignment"
    weight: 0.5

# Domain framing for the LLM briefing prompts. Externalized here so prompt
# wording is config-driven, not hardcoded in scripts/intelligence.py.
#   domain:    fills "a daily {domain} intelligence briefing"
#   audience:  the reader the model writes for ("matter to {audience}")
#   landscape: the field whose implications the weekly deep dive weighs
#   actionable: when true, summaries lead with the date/place/cost/decision
#               the reader can act on (default false)
#   priorities: optional ordered ranking tiers used by news ranking, blog
#               ranking, and the executive summary. Tier 1 fills most slots;
#               lower tiers appear only when genuinely consequential. Omit to
#               keep the default "rank by importance" behavior.
briefing_profile:
  domain: "AI and technology"
  audience: "an AI researcher or engineer"
  landscape: "the AI and technology landscape"
  # actionable: false
  # priorities:
  #   - "What changes the reader's day: outages, closures, deadlines, events."
  #   - "Policy and rule changes with concrete effects."
  #   - "Market and investment angles. Secondary -- never lead with them."

# Default Brave freshness window for news queries with no branch binding
# ("pd" past day, "pw" past week, "pm" past month). Interest-graph branches can
# override it per node -- see references/config_guide.md.
news_freshness: "pd"

# Geographic relevance gate. Drops fetched news that never mentions a place
# term before it reaches the LLM ranking layer; items from trusted_sources pass
# without a match. Omit the block entirely to keep every result.
# geo_filter:
#   enabled: true
#   place_terms: ["san diego", "california"]
#   trusted_sources: ["voiceofsandiego.org"]
#   blocked_sources: ["openpr.com", "prnewswire.com"]   # never ranked

# Cap on items from a single outlet per section (default 2).
# source_diversity:
#   max_per_source: 3

# Collapse the same story syndicated by many outlets (Jaccard overlap of
# headline content words). Disabled unless configured.
# news_similarity_dedup:
#   enabled: true
#   threshold: 0.3

# Active public-safety alerts (National Weather Service). Free, no API key,
# rendered without the LLM. Find zones via api.weather.gov/points/<lat>,<lon>
# and add "alerts" to section_order to render the section.
# alerts:
#   enabled: true
#   provider: "nws"
#   zones: ["CAZ043"]
#   max_alerts: 4
#   user_agent: "atlas-morning-briefing (you@example.com)"

# Pipeline identity. Give each pipeline on a machine its own status file, or
# the one that runs second overwrites the first one's counters.
pipeline_name: "atlas"
status_file_path: "status.json"

# Daily quality check (scripts/quality_check.py, run after the briefing).
# See references/config_guide.md and references/quality_monitoring_design.md.
# quality_check:
#   section_floors:
#     news: 3
#   alert_email:
#     recipients: ["you@example.com"]
#     daily_digest: false
#   judge:
#     dimensions: ["lead_alignment", "actionability", "specificity", "freshness"]
#   source_health:
#     dead_url_runs: 3
#     stale_after_days: 90
#     zero_run_threshold: 7
#     median_window: 30
#     feed_overrides:
#       "Some Slow Blog":
#         stale_after_days: 400

# Stock watchlist (Finnhub API)
stocks:
  - AMZN
  - GOOGL
  - TSLA
  - SPY

# News search queries (Brave Search API)
news_queries:
  - "AI artificial intelligence breakthrough"
  - "LLM agent framework"
  - "autonomous driving AI"
  - "OpenAI GPT model release"
  - "Anthropic Claude"
  - "Google DeepMind Gemini"
  - "AI regulation policy"
  - "semiconductor chip Nvidia"
  - "robotics embodied AI"

# Paper scoring weights
paper_scoring:
  has_code: 7
  topic_match: 3
  recency: 2
  citation_count: 1

# Reproduction feasibility gate (applied by intelligence layer)
# Papers scoring below repro_min_score/25 are dropped from top picks
repro_min_score: 12

# Delivery settings
kindle_email: "YOUR_NAME@kindle.com"
sender_email: "your-sender@gmail.com"
output_format: "kindle"

# Email distribution list (receives rich HTML briefing)
email_recipients:
  - "your-email@example.com"

# File naming pattern
file_naming: "Atlas-Briefing-{yyyy}.{mm}.{dd}"

# Paper recommendations
num_paper_picks: 3

# Date range for arxiv search (days)
arxiv_days_back: 3

# Blog freshness window, separate from arxiv_days_back. Blogs and papers have
# different cadences: at 3 days a weekly blogger is invisible on most runs,
# which the quality checker reported as a yield collapse against feeds that
# were healthy. Measured 2026-08-29 across 28 feeds: 17 had posted within 3
# days, 19 within 7, 21 within 14. Cross-day dedup stops a wider window from
# re-showing an item the reader already saw.
blog_days_back: 7

# ArXiv fetch behaviour (legacy export.arxiv.org path).
#
# Topics are scanned SEQUENTIALLY, matching upstream. This used to run 8
# topics concurrently, which exceeds what export.arxiv.org tolerates: a run on
# 2026-08-27 lost 20/20 topic searches to 429s and read timeouts and shipped a
# briefing with no papers at all. ArXiv's terms ask for ~1 request per 3s.
arxiv_request_delay: 3.0
#
# Wrap multi-word topics in quotes for an exact phrase match. Upstream does
# this by default; measured against the live API on 2026-08-28 it returned 0
# papers for 7 of the 9 multi-word topics above (at 3 and at 14 days back),
# because these topics are conceptual descriptions rather than literal
# phrases. Recall is preferable here since TF-IDF scoring and the interest
# profile already cull irrelevant hits. Turn on only if your topics are
# literal phrases that appear verbatim in paper text.
arxiv_exact_phrase: false

# Maximum items per section
max_papers: 30
max_blogs: 12
max_news: 15

# PDF settings
pdf:
  font_size: 10
  line_spacing: 1.5
  include_toc: true
  include_emoji: false

# OpenCode configuration (alternative to Gemini/Bedrock).
# When enabled, uses `opencode run` with free-tier models.
# Requires `opencode` binary on PATH and a valid OpenCode Zen session.
opencode:
  enabled: false
  models:
    heavy: "opencode/nemotron-3-ultra-free"
    medium: "opencode/deepseek-v4-flash-free"
    light: "opencode/deepseek-v4-flash-free"
  # Fallback chain tried (in order) when the primary model for a tier fails
  # (non-zero exit, empty NDJSON response, or timeout) — e.g. when the free
  # opencode quota is exhausted.
  fallback_models:
    heavy: ["opencode/mimo-v2.5-free", "opencode/nemotron-3.5-lightning-free"]
    medium: ["opencode/mimo-v2.5-free", "opencode/nemotron-3.5-lightning-free"]
    light: ["opencode/mimo-v2.5-free", "opencode/nemotron-3.5-lightning-free"]
  max_calls_per_run: 50
  # Per-call timeout. Fast failures (model not found, insufficient balance,
  # rate limit) are detected immediately via NDJSON error events and skip
  # straight to the fallback chain — they never wait for the full timeout.
  # Retryable errors (rate limits, server overload) get 2 retries with
  # exponential backoff (5-15s) before advancing to the next model.
  timeout: 120
  # Number of retries for retryable errors before falling back. Set to 0
  # to disable retries entirely.
  max_retries_per_model: 2

# OpenRouter configuration (OpenAI-compatible HTTP API)
# Requires OPENROUTER_API_KEY. Slugs carry a single `openrouter/` routing
# prefix that the client strips before calling the API.
#
# Keep the ladder monotonic — heavy > medium > light in both model size and
# context window — and let fallbacks degrade DOWN a tier only, never up, so a
# heavy prompt can never silently land on a light model.
#
# Free models on OpenRouter come and go. Re-verify a slug before adding it:
#   curl -H "Authorization: Bearer $OPENROUTER_API_KEY" \
#        https://openrouter.ai/api/v1/models | jq -r '.data[] | select(.id|endswith(":free")) | .id'
# and confirm it returns non-empty `choices[0].message.content` for a real
# prompt — several free models answer 200 with an empty body because reasoning
# tokens consume the whole max_tokens budget.
#
# Avoid `openrouter/auto`: despite the name it is the PAID auto-router.
openrouter:
  enabled: false
  api_base: "https://openrouter.ai/api/v1/chat/completions"
  models:
    heavy: "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free"
    medium: "openrouter/minimax/minimax-m3:free"
    light: "openrouter/nvidia/nemotron-3-super-120b-a12b:free"
  fallback_models:
    heavy: ["openrouter/dots-studio/dots-3-note-preview:free", "openrouter/minimax/minimax-m3:free"]
    medium: ["openrouter/nvidia/nemotron-3-super-120b-a12b:free", "openrouter/dots-studio/dots-3-note-preview:free"]
    light: ["openrouter/cohere/north-mini-code:free", "openrouter/minimax/minimax-m3:free"]
  max_calls_per_run: 100
  # Simultaneous in-flight requests. The runner enriches sections in parallel
  # (see max_workers), so this is the real throttle against the free tier.
  max_concurrent_requests: 4
  timeout: 120
  max_tokens: 4096
  temperature: 0.3
  # Used only for the "equivalent paid cost" line in the usage summary; the
  # summary reports the API's own cost field for what was actually billed.
  pricing:
    input_per_million: 0.0
    output_per_million: 0.0
  # Estimated pricing if using paid DeepSeek V4 Flash API (e.g. Deep Infra)
  # instead of the free opencode model. Used in the usage summary footer.
  pricing:
    input_per_million: 0.14    # $0.14 per 1M input tokens
    output_per_million: 0.28   # $0.28 per 1M output tokens

# Amazon Bedrock configuration
# Set enabled: false to run in deterministic mode (no LLM, zero cost)
bedrock:
  enabled: true
  region: "us-east-1"
  temperature: 0.3
  max_tokens: 2048
  # Use cross-region inference profile IDs (us.*) for broad region support.
  # On-demand IDs (e.g. amazon.nova-lite-v1:0) may not work in all regions.
  models:
    heavy: "us.anthropic.claude-sonnet-4-20250514-v1:0"
    medium: "us.amazon.nova-pro-v1:0"
    light: "us.amazon.nova-lite-v1:0"
  # Maximum LLM calls per run (default: 20). The intelligence layer makes
  # ~10-15 calls with default settings. Increase if you have many papers or
  # enable all intelligence features.
  max_calls_per_run: 25

# Logging
log_level: "INFO"

# Tracked entities for competitive intelligence
tracked_entities:
  - name: "OpenAI"
    type: "company"
  - name: "Anthropic"
    type: "company"
  - name: "Google DeepMind"
    type: "company"
